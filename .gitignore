# secrets and per-host config
.env
.env.*
!.env.example
scaffold/.env
scaffold/.env.*
!scaffold/.env.example

# data root and generated output.
#
# /data/* rather than /data/, and the library re-included: data/library IS SOURCE - the hand-authored
# malfunction and guide catalogues that seed:library reads and that the IMAGE copies at
# `COPY data/library /app/data/library`. Excluding the whole directory kept it out of every clone,
# so the first build on cvx-hel1 failed at that COPY with "/data/library: not found" (2026-09-19).
# The same rule already existed in scaffold/.gitignore, which governs scaffold/data/ and not this
# one; fixing that file in September did not fix this path. A parent directory that is excluded
# cannot have its children re-included, which is why this is /data/* and not /data/.
#
# Everything else under /data/ is GENERATED and stays out: programs (gen:programs), roster
# (gen:roster), history (seed:history).
/data/*
!/data/library/
scaffold/data/
*.pdf.tmp
/exports/

# node / next
node_modules/
.next/
scaffold/.next/
scaffold/tsconfig.tsbuildinfo
npm-debug.log*

# session and scratch artefacts — never commit these
.cookie_*
*.cookie
*.tmp
*.log
_to_delete/

# design source (kept locally, not shipped)
Media/Logo/*.ai

# OS
.DS_Store
Thumbs.db
