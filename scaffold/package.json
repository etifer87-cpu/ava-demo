{
  "name": "tms-kit-scaffold",
  "version": "0.1.0",
  "private": true,
  "description": "Runnable scaffold for a competency-based Training Management System. Vendor-neutral: no operator, authority or product identity anywhere.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "migrate": "node --env-file=.env scripts/migrate.mjs",
    "config:load": "node --env-file=.env scripts/load-analytics-config.mjs",
    "seed:framework": "node --env-file=.env scripts/seed-framework.mjs",
    "seed:templates": "node --env-file=.env scripts/seed-templates.mjs",
    "seed:synthetic": "node --env-file=.env scripts/seed-synthetic.mjs",
    "verify": "node --env-file=.env scripts/neutrality-scan.mjs && node --env-file=.env scripts/verify.mjs",
    "reset": "node --env-file=.env scripts/reset-to-seed.mjs",
    "smoke": "node --env-file=.env scripts/smoke-screens.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "scan": "node --env-file=.env scripts/neutrality-scan.mjs",
    "password": "node --env-file=.env scripts/set-password.mjs"
  },
  "dependencies": {
    "next": "^16.0.0",
    "pg": "^8.13.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
