# TMS Kit - environment reference
#
# Copy to .env (never commit it), fill in, chmod 600.
# Every variable the platform reads is listed here by NAME with its purpose and safe default.
# THIS FILE IS THE NAME AUTHORITY. If code reads a variable, its name is decided here and the code
# follows; a variable read under a name this file does not carry is a setting nobody can set.
# Values are deliberately empty. No secret, token, password or real hostname belongs in this file.
# One .env per environment. Never copy an .env between hosts - see docs/15_DEPLOYMENT.md.

# =============================================================================
# 1. Runtime identity
# =============================================================================

# Which environment this host is. Printed by /api/health and asserted by the deploy script.
# One of: dev | stage | prod
APP_ENV=

# Commit sha baked into the image at build time. Reported by /api/health as "release".
# Set by the build, not by hand.
APP_RELEASE=

# Public base URL of this instance, used for absolute links in generated reports and emails.
# Example shape: https://tms.example.invalid
APP_BASE_URL=

# Node environment. production for anything deployed; development only on a workstation.
NODE_ENV=production

# =============================================================================
# 2. Image tags - ONE VARIABLE PER ENVIRONMENT (docs/15 section 4)
# =============================================================================
# Never a shared tag, never "latest". Immutable, commit-sha-suffixed.
# compose.stage.yml reads APP_IMAGE_STAGE; compose.prod.yml reads APP_IMAGE_PROD.
# A stage .env therefore cannot supply a prod image even by accident.

APP_IMAGE_STAGE=
APP_IMAGE_PROD=
AUTOMATION_IMAGE=
INFERENCE_IMAGE=

# Set by the stage/prod overlay from the two above, never by hand. deploy/compose.yml refuses to
# start without it, which is what stops a bare `up -d` running whatever was built last.
APP_IMAGE=

# =============================================================================
# 3. Ports (host side, all bound to 127.0.0.1 by compose)
# =============================================================================
# Docker bypasses the host firewall; the loopback bind is what keeps these private.

APP_PORT=3000
DB_PORT=5432
PDF_PORT=3101
AUTOMATION_PORT=5678
INFERENCE_PORT=11434

# =============================================================================
# 4. Database
# =============================================================================
# Direct pg from server code only. There is no REST-over-Postgres layer.

# Full connection string used by the app and by scripts/migrate.mjs.
# Shape: postgres://<user>:<password>@db:5432/<database>
DATABASE_URL=

# Used by the postgres container's entrypoint on first boot.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Role that owns the schema. Migrations run as this role; the cluster superuser cannot
# ALTER objects owned by it.
DB_MIGRATION_ROLE=

# Pool sizing for the app. Keep well under the server's max_connections. Read by lib/db.ts.
DB_POOL_MAX=10

# Statement timeout in milliseconds for application queries. Analytics views are slower;
# scripts override this per query. Read by lib/db.ts, which falls back to 8000 when unset.
DB_STATEMENT_TIMEOUT_MS=15000

# A query slower than this is logged with its first 120 characters. A ceiling on noise, not a
# budget: the budget is two seconds for anything on the request path. Read by lib/db.ts.
DB_SLOW_QUERY_MS=1000

# =============================================================================
# 5. Filesystem
# =============================================================================

# The single root every path in the platform derives from: uploads, stored records,
# generated PDFs, exports. Changing this one value is the whole data migration.
# Mounted into the app container at /data.
DATA_ROOT=

# Maximum accepted upload size in bytes. Default 32 MiB.
UPLOAD_MAX_BYTES=33554432

# =============================================================================
# 6. Authentication and sessions
# =============================================================================

# Secret used to sign and verify session cookies. Rotating it logs everyone out.
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Session lifetime in seconds. Default 12 hours. Read by lib/session.ts for BOTH the cookie's
# max-age and the server-side expiry check, so the two cannot disagree.
SESSION_TTL_SECONDS=43200

# Name of the session cookie. Read by lib/session.ts and by proxy.ts. Change it only to run two
# instances on one hostname; changing it signs everyone out.
SESSION_COOKIE_NAME=tms_session

# Shared secret for cookie-less server-to-server calls (the automation runner calling the
# app). Sent as the x-internal-token header and checked before any route logic runs.
# A different value per environment. Never the same string on stage and prod.
INTERNAL_API_TOKEN=

# Force a password change on first login. Leave true.
AUTH_FORCE_PASSWORD_CHANGE=true

# =============================================================================
# 7. PDF rendering
# =============================================================================

# Base URL of the headless-Chromium renderer, as reached from inside the app container:
# the SERVICE NAME and its INTERNAL port. Not the published host port - that is
# unreachable from another container and every export fails with a bare fetch error.
# Default: http://pdf:3000
PDF_URL=http://pdf:3000

# Render timeout in milliseconds. A long report with many charts needs headroom.
PDF_TIMEOUT_MS=120000

# =============================================================================
# 8. Inference seam (docs/11)
# =============================================================================
# One seam, three variables. Nothing above scaffold/lib/inference.ts knows the vendor.
# The endpoint must speak the OpenAI-compatible chat completions API.
#
# LEAVE LLM_BASE_URL EMPTY to run in degraded mode: every figure, chart, table and export
# still renders, only generated prose is absent. This is a supported, tested state.

# Base URL, without a trailing slash. Hosted API, corporate gateway or the local
# inference container (http://inference:11434/v1) - all the same variable.
LLM_BASE_URL=

# API key for the endpoint. Empty for a local runtime that has no auth.
LLM_API_KEY=

# Model names. Both may point at the same model; that must not break anything.
# fast: classify, extract, per-document map step.
# deep: multi-record structured findings, narrative and report assembly.
LLM_MODEL_FAST=
LLM_MODEL_DEEP=

# Per-tier request timeouts in milliseconds. Raise these well beyond a hosted API's needs:
# a local runtime at ~30 tokens/s takes minutes for a long completion.
LLM_TIMEOUT_FAST_MS=60000
LLM_TIMEOUT_DEEP_MS=300000

# Output token budgets per tier. Also settable per call site in config/inference.yaml.
LLM_MAX_TOKENS_FAST=3000
LLM_MAX_TOKENS_DEEP=16000

# Sampling temperature. 0 for extraction and structured findings; narrative assembly may
# use up to 0.3. Nothing in this platform runs higher.
LLM_TEMPERATURE=0

# Number of repair retries after a schema-validation failure. One. After that the run
# fails loud and stores the raw response - it is never defaulted into a fallback object.
LLM_REPAIR_RETRIES=1

# =============================================================================
# 9. Pipeline behaviour (docs/11)
# =============================================================================

# Hard truncation of extracted document text before any model call.
INGEST_MAX_CHARS=60000

# Below this many characters of extracted text the document is a scan, not a document.
# Fail loud and route to OCR or a human rather than sending it to a model.
INGEST_MIN_CHARS=100

# Distinct structural markers required before a document is treated as a record candidate
# and earns a model call. The marker list itself lives in config/ingest.yaml.
INGEST_MIN_MARKERS=2

# Cap on the concatenated record corpus for a single analysis call. Above this, the
# pipeline switches to map-reduce rather than dropping documents.
ANALYSIS_MAX_CHARS=45000

# Provenance gate thresholds (scaffold/lib/provenance.ts). Fraction of numbers in generated
# narrative that must match the deterministic figure set, and fraction of available sources
# that must be cited. 1.0 means no unsourced figure is tolerated.
PROVENANCE_MIN_SCORE=1.0
PROVENANCE_MIN_COVERAGE=0.6

# =============================================================================
# 10. Automation runner (optional service)
# =============================================================================

# Image for the orchestrator of your choice. No default: any runner that can call HTTP, run
# code and read a mounted directory implements scaffold/automation/*.md.
# (set AUTOMATION_IMAGE in section 2)
#
# Base URL of the runner, as reached from the app container.
AUTOMATION_URL=http://automation:5678

# Encrypts the runner's stored credentials. REQUIRED if the runner is used, and changing
# it orphans every stored credential.
AUTOMATION_ENCRYPTION_KEY=

# Filesystem allowlist for the runner's disk nodes. Must include the shared data mount or
# file reads fail silently. Use a SINGLE path: some builds do not split a delimited list.
AUTOMATION_FILE_ALLOWLIST=/data

# Must be false for pipeline code steps to read environment variables (they need
# INTERNAL_API_TOKEN). Counter-intuitive name; false means "do not block".
AUTOMATION_BLOCK_ENV_ACCESS=false

# =============================================================================
# 11. Local inference runtime (optional service)
# =============================================================================
# The runtime has NO authentication of any kind. Loopback only, or a rule scoped exactly
# to the container subnet. See docs/15 section 2.

# Any runtime serving an OpenAI-compatible /v1/chat/completions works; set INFERENCE_IMAGE
# in section 2. These names are generic - map each to the variable your runtime reads.
#
# Bind address inside the container. A loopback default is unreachable from other
# containers, which is why this is set explicitly.
INFERENCE_HOST=0.0.0.0

# Prerequisite for KV-cache quantisation below.
INFERENCE_FLASH_ATTENTION=1

# KV cache precision. q8_0 roughly halves KV memory at a long context and is often the
# difference between full GPU residency and a spill to CPU.
INFERENCE_KV_CACHE_TYPE=q8_0

# Context window for the derived model.
INFERENCE_NUM_CTX=40960

# =============================================================================
# 12. Edge / tunnel
# =============================================================================

# Credential for the outbound-dialling tunnel. The only public ingress; nothing inbound
# is opened. Per environment, never shared.
TUNNEL_TOKEN=

# =============================================================================
# 13. Backup
# =============================================================================

# Off-site destination for dumps and the data root mirror. Shape: user@host:/path
BACKUP_REMOTE=

# SSH port for the backup destination, if not 22.
BACKUP_SSH_PORT=22

# Path to the private key used for the backup transfer. Key-only, no password.
BACKUP_SSH_KEY=

# How many daily dumps to retain on the local disk before relying on the off-site copy.
BACKUP_LOCAL_RETENTION=14

# =============================================================================
# 14. Integration (optional, docs/12)
# =============================================================================
# All of these are inert until the corresponding connector is enabled.

# Base URL of the external learning management system's API.
LMS_API_URL=
# Credentials for the LMS sync job. Prefer an account and password over a captured session
# cookie: an expired cookie breaks the schedule silently.
LMS_API_USER=
LMS_API_PASSWORD=

# Base URL of the crew-scheduling system's API and its key.
CREWSCHED_API_URL=
CREWSCHED_API_KEY=

# Identity provider for single sign-on.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# =============================================================================
# 15. Observability
# =============================================================================

# Log level: error | warn | info | debug
LOG_LEVEL=info

# Emit structured JSON logs. Leave true for anything deployed.
LOG_JSON=true

# Container timezone, used by the automation runner's schedule display. UTC everywhere else:
# every timestamp in the database is TIMESTAMPTZ and every date in a report is rendered from it.
TZ=UTC

# Optional error-reporting endpoint. Empty disables reporting entirely.
ERROR_REPORTING_URL=
