{
  "meta": {
    "purpose": "Starter template. Synthetic content, authored against docs/05_TEMPLATES_AND_BUILDER.md section 2. No operator syllabus, no operator course code, no operator wording.",
    "authored_for": "docs/05_TEMPLATES_AND_BUILDER.md section 6",
    "fan_out_note": "ONE EVENT, MANY SUBJECTS. Signing fans the event out into one record per subject. The outcome is per subject even though the event is shared: a classroom of twelve with one outcome row is a reporting dead end the first time one person does not attend.",
    "no_attempts_note": "No setup block and no malfunctions. Attempts are not offered: a re-sit is a new session, not an attempt on the same row."
  },
  "code": "SEED-GND-SCH",
  "name": "Ground school knowledge event (starter)",
  "kind": "ground_school",
  "asset_class_code": null,
  "org_unit_code": null,
  "version": {
    "period": "starter",
    "change_note": "Initial published version, seeded with the kit.",
    "notes": "Classroom form: attendance group, six knowledge checks, per-subject outcome, fan-out on signature.",
    "allowed_assessor_roles": ["ground_instructor", "instructor", "examiner"],
    "hide_record_from_subject": false,
    "setup": {
      "rows": [
        { "label": "Course title", "value": "" },
        { "label": "Module", "value": "" },
        { "label": "Delivery mode", "value": "" },
        { "label": "Duration", "value": "" }
      ],
      "notes": "A classroom event carries no device set-up and no reset blocks; the renderer draws the header from these rows only."
    }
